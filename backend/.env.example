NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=boilerplate

# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-in-production-with-at-least-32-bytes
JWT_ISSUER=boilerplate-api
# Optional override for a separate external-client token signing key.
API_CLIENT_JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_TTL_MINUTES=20160

FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379
